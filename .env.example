# Server Environment Configuration
FLASK_ENV=production
PORT=5000
SECRET_KEY=veinguard-secure-prod-key-change-this

# Database Settings (sqlite or mysql)
DB_TYPE=sqlite
SQLITE_PATH=database/veinid_db.sqlite

# MySQL Settings (only if DB_TYPE=mysql)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=veinid_db
